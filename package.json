{
  "name": "digital-process-group-site",
  "version": "1.1.0",
  "private": true,
  "description": "Site Digital Process Group + quiz d'évaluation intégré",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:academy": "npm --prefix academy-app ci && npm --prefix academy-app run build",
    "build": "npm run build:academy && node -e \"require('fs').mkdirSync('public',{recursive:true}); require('fs').writeFileSync('public/.gitkeep','')\"",
    "dev:academy": "npm --prefix academy-app run dev",
    "test:academy": "node scripts/academy-e2e.mjs",
    "validate:academy": "npm --prefix academy-app run validate:content"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
