# Conservée pour la signature des sessions quiz (fallback de SESSION_SECRET)
# Ne jamais committer le vrai .env
GEMINI_API_KEY=

# Optionnel — secret pour signer les sessions quiz (sinon dérivé de GEMINI_API_KEY)
# SESSION_SECRET=

# Port local (Vercel injecte PORT automatiquement)
PORT=3000

# CRM Airtable — table Prospects. Ne jamais committer le jeton.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Prospects

# DPG Academy · Atelier Claude (/academy/claude)
# Code d'accès partagé (démonstration) — JAMAIS en variable VITE_* / NEXT_PUBLIC_*
ACADEMY_ACCESS_CODE=
# Secret distinct et imprévisible pour signer le cookie de session HttpOnly
ACADEMY_SESSION_SECRET=
