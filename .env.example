# Clé API Google Gemini (obligatoire pour le quiz /evaluation)
# Ne jamais committer le vrai .env
GEMINI_API_KEY=

# Optionnel — secret pour signer les sessions quiz (sinon dérivé de GEMINI_API_KEY)
# SESSION_SECRET=

# Port local (Vercel injecte PORT automatiquement)
PORT=3000

# CRM Airtable — table Prospects. Ne jamais committer le jeton.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Prospects
