# Clé API Google Gemini.
# Le QCM ne l'appelle plus. Elle reste le secret de secours pour signer les
# sessions si SESSION_SECRET n'est pas défini. Ne pas la retirer de Vercel
# tant que ce secours est en place.
# Ne jamais committer le vrai .env
GEMINI_API_KEY=

# Optionnel — secret pour signer les sessions quiz (sinon dérivé de GEMINI_API_KEY)
# SESSION_SECRET=

# Port local (Vercel injecte PORT automatiquement)
PORT=3000
