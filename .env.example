# Clé API Google Gemini (jamais commitée — copier vers .env en local)
# Vercel : Project Settings → Environment Variables → GEMINI_API_KEY
GEMINI_API_KEY=

# Optionnel — secret de signature des sessions quiz (sinon dérivé de GEMINI_API_KEY)
# SESSION_SECRET=

# Optionnel — modèle Flash (défaut: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Port local uniquement (Vercel injecte PORT automatiquement)
PORT=3000
